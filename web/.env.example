# Enquiry mailer (src/app/api/enquiry/route.ts). Copy to .env.local and fill in; never commit .env.local.
# Any SMTP provider works: Google Workspace, Zoho, Microsoft 365, Amazon SES, Resend SMTP, Brevo...

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); leave empty for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# The address mail is sent from (must be allowed by your SMTP provider), and where enquiries arrive.
MAIL_FROM=website@avvvs.com
MAIL_TO=mail@avvvs.com

# true sends the enquirer a short "we have your enquiry" email.
SEND_ACK=false

# Analytics and verification. All optional: a tag without its ID never loads, and none load
# without the visitor's consent (see src/components/Analytics.tsx).
# GA4 measurement ID, from Google Analytics > Admin > Data streams (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta Pixel ID, from Meta Events Manager (a number)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console: the content value of the HTML-tag verification method
NEXT_PUBLIC_GSC_VERIFICATION=
# Meta Business domain verification (the current avvvs.com site already publishes one)
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Journal admin (/admin). Add both stores from the Vercel project's Storage tab; they set these.
# Neon Postgres: articles and accounts. Tables are created on first use.
DATABASE_URL=
# Vercel Blob: images uploaded in the editor.
BLOB_READ_WRITE_TOKEN=
# Any long random phrase (16+ characters). Needed once, at /admin/setup, to create the first admin.
ADMIN_SETUP_KEY=
